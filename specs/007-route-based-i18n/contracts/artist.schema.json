{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://music-hits.example.com/schemas/artist.json",
  "title": "Artist Translations Schema",
  "description": "Schema for artist page translations",
  "type": "object",
  "required": ["title", "followers", "genres", "topTracks", "relatedArtists", "biography", "noData"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Artist page title"
    },
    "followers": {
      "type": "string",
      "description": "Followers count label"
    },
    "genres": {
      "type": "string",
      "description": "Genres section label"
    },
    "topTracks": {
      "type": "string",
      "description": "Top tracks section label"
    },
    "relatedArtists": {
      "type": "string",
      "description": "Related artists section label"
    },
    "biography": {
      "type": "string",
      "description": "Biography section label"
    },
    "noData": {
      "type": "string",
      "description": "No data available message"
    }
  },
  "additionalProperties": false
}